# ─── Build output ────────────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ─── Compiled classes ────────────────────────────────────────────────────────
*.class

# ─── Package files ───────────────────────────────────────────────────────────
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ─── JVM crash logs ──────────────────────────────────────────────────────────
hs_err_pid*
replay_pid*

# ─── Spring Boot DevTools ────────────────────────────────────────────────────
.reloadtrigger

# ─── Local application config (contains DB credentials) ──────────────────────
application-local.properties
application-local.yml
application-secrets.properties

# ─── IntelliJ IDEA ───────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr

# ─── Eclipse ─────────────────────────────────────────────────────────────────
.classpath
.project
.settings/
bin/

# ─── VS Code ─────────────────────────────────────────────────────────────────
.vscode/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
