<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Seed data — runs ONLY in 'local' and 'test' Liquibase contexts.
        Never executed in production.
        Delegates to a SQL file so the data generator can be a script.
    -->
    <changeSet id="0004-seed-data" author="acme" context="local,test">
        <sqlFile path="db/seed/seed-employees.sql"
                 relativeToChangelogFile="false"
                 splitStatements="true"
                 stripComments="true"/>
    </changeSet>

</databaseChangeLog>
