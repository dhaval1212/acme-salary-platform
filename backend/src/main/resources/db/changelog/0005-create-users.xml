<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Application users — the allowlist of accounts permitted to log in.
        No public registration endpoint exists; users are provisioned
        explicitly via the 0006-seed-users changeset (local/test contexts)
        or by a controlled administrative process in production.
    -->
    <changeSet id="0005-create-users" author="acme">
        <createTable tableName="users">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_users_username"/>
            </column>
            <!-- BCrypt hash — never store plaintext passwords -->
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <!-- Role supporting future RBAC expansion -->
            <column name="role" type="VARCHAR(50)" defaultValue="HR_MANAGER">
                <constraints nullable="false"/>
            </column>
            <!-- Disabled accounts cannot log in; preferred over hard-deletes -->
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE users
            ADD CONSTRAINT chk_users_role
            CHECK (role IN ('HR_MANAGER', 'ADMIN'));
        </sql>

        <createIndex tableName="users" indexName="idx_users_username">
            <column name="username"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
