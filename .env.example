# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.
# Never put real credentials or secrets in this file.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=compensation
DB_USER=compensation
DB_PASSWORD=compensation

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
# Minimum 32 characters. Application fails to start if not set.
JWT_SECRET=<replace-with-openssl-rand-hex-32-output>

# Token lifetime in milliseconds. Default: 3600000 (1 hour).
JWT_EXPIRATION_MS=3600000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:4200
