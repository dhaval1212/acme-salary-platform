# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────────────────────
dist/
build/

# ─── Angular CLI cache ───────────────────────────────────────────────────────
.angular/
.cache/

# ─── Test output ─────────────────────────────────────────────────────────────
coverage/
junit.xml
test-results/

# ─── Environment files (generated per machine) ───────────────────────────────
# Keep src/environments/environment.ts (default)
# Keep src/environments/environment.prod.ts (production template)
# Ignore any local override files
src/environments/environment.local.ts

# ─── Package manager locks (keep only one) ───────────────────────────────────
# Commit package-lock.json (npm). If using yarn, swap these two lines.
yarn.lock

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json

# ─── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
