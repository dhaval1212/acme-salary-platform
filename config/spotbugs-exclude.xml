<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
                        https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!--
        SpotBugs exclusion filter for the ACME Compensation Hub.

        This file excludes known false-positives and intentional patterns
        from SpotBugs analysis. Only add entries here with a clear comment
        explaining WHY the warning is suppressed.

        Reference: https://spotbugs.readthedocs.io/en/stable/filter.html
    -->

    <!-- ── Entry point ─────────────────────────────────────────────────────── -->
    <!-- CompensationApplication has no logic — only @SpringBootApplication. -->
    <Match>
        <Class name="com.acme.compensation.CompensationApplication"/>
    </Match>

    <!-- ── DTOs ────────────────────────────────────────────────────────────── -->
    <!--
        DTOs are simple data carriers (records or plain classes with getters).
        SpotBugs flags mutable array fields and EI_EXPOSE_REP patterns in them,
        but they are intentional value-holder objects with no encapsulation risk.
    -->
    <Match>
        <Package name="~com\.acme\.compensation\..*\.dto"/>
    </Match>

    <!-- ── JPA Entities ────────────────────────────────────────────────────── -->
    <!--
        JPA entities require a public/protected no-arg constructor which
        SpotBugs may flag as UWF_UNWRITTEN_FIELD for fields set by Hibernate
        via reflection.
    -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
        <Package name="~com\.acme\.compensation\..*"/>
    </Match>

</FindBugsFilter>
