<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
    Checkstyle suppressions for the ACME Compensation Hub.

    Use this file to suppress rules for specific files or patterns where
    a violation is intentional or unavoidable (e.g., generated code,
    framework-required patterns).

    Format:
        <suppress files="..." checks="..." lines="..."/>

    Reference: https://checkstyle.org/filters/suppressionfilter.html
-->
<suppressions>

    <!-- Test files: relax method length and complexity — test methods
         can legitimately be long due to arrange/act/assert structure. -->
    <suppress files=".*Test\.java"     checks="MethodLength"/>
    <suppress files=".*Test\.java"     checks="CyclomaticComplexity"/>
    <suppress files="TestFixtures\.java" checks="MethodLength"/>

    <!-- Spring Boot entry point: generated by initializr, no logic inside. -->
    <suppress files="CompensationApplication\.java" checks=".*"/>

    <!-- Enum files: ModifierOrder false-positives on enum constants. -->
    <suppress files="EmployeeStatus\.java" checks="ModifierOrder"/>

    <!-- JPA entities use single-line getter/setter bodies for compactness:
             public UUID getId() { return id; }
         LeftCurly flags the '{' on the same line as the method signature.
         This is widely accepted Java style for pure accessor methods. -->
    <suppress files="Employee\.java"            checks="LeftCurly"/>
    <suppress files="CompensationHistory\.java"  checks="LeftCurly"/>

    <!-- SLF4J loggers are universally declared as 'log' (lowercase).
         Checkstyle's ConstantName rule requires UPPER_SNAKE_CASE for static
         final fields, but 'log' is the established convention for loggers. -->
    <suppress checks="ConstantName" message="Name 'log' must match"/>

</suppressions>
